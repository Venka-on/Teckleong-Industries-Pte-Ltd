<IfModule mod_headers.c>
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Strict-Transport-Security "max-age=2592000"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://*.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com https://*.doubleclick.net https://*.google.com https://*.google.com.sg https://www.googleadservices.com https://*.gstatic.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.doubleclick.net https://*.google.com https://*.google.com.sg https://www.googleadservices.com; frame-src https://*.googletagmanager.com https://*.doubleclick.net https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>
# copper.asia - Apache rules for Exabytes Plesk (LF line endings)
Options -MultiViews -Indexes
# Folders share names with pages (e.g. /products and products.html). Without this, Apache adds a slash
# and our slash rule removes it again = redirect loop.
DirectorySlash Off
DirectoryIndex index.html
AddDefaultCharset UTF-8
RewriteEngine On

# 1) www -> non-www. HTTP -> HTTPS is switched on in Plesk (Hosting Settings), not here.
RewriteCond %{HTTP_HOST} ^www\.copper\.asia$ [NC]
RewriteRule ^ https://copper.asia%{REQUEST_URI} [R=301,L]

# 2) Legacy URLs from the old site -> current URLs
RewriteRule ^cms/Brands(?:\.html)?/?$ /cms/Blog [R=301,L]
RewriteRule ^(?:home|default\.aspx)/?$ / [R=301,L,NC]
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html/?$ / [R=301,L,NC]
RewriteRule ^products\.asp$ /products [R=301,L,NC]
RewriteRule ^Enquiry(?:\.html)?/?$ /cms/Enquiry [R=301,L,NC]

# 3) Direct .html requests -> clean URL (THE_REQUEST so internal rewrites do not loop)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# 4) Trailing slash -> clean URL when a matching .html page exists (e.g. /products/, /cms/Blog/)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1 [R=301,L]

# 5) Clean URL -> matching .html file (last)
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [END]

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff .woff
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml text/xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/xml text/xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(?:css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(?:woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
